#!/usr/bin/env bash
# Open kiro-horror-tui in a dressed-up "Crypt" Ghostty window:
# theme (crypte.conf) + post-processing (crypte.glsl).
#
#   ghostty/crypte [--no-shader] [kiro-horror-tui options…]
#   ghostty/crypte --muse-auth
#
# Builds the release version on first launch.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(dirname "$here")"
bin="$root/target/release/kiro-horror-tui"
if [ ! -x "$bin" ]; then
    cargo build --release --manifest-path "$root/Cargo.toml"
fi
shader=(--custom-shader="$here/crypte.glsl")
if [ "${1:-}" = "--no-shader" ] || [ "${1:-}" = "--sans-shader" ]; then
    shader=()
    shift
fi
exec ghostty --config-file="$here/crypte.conf" "${shader[@]}" -e "$bin" "$@"
