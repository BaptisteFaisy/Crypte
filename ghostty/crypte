#!/usr/bin/env bash
# Run kiro-horror-tui in the current terminal when it can host the crypt,
# else in a dressed-up "Crypt" Ghostty window (theme + shader).
#
#   ghostty/crypte [--window] [--no-shader] [kiro-horror-tui options…]
#   ghostty/crypte rebuild [--window] [--no-shader] [kiro-horror-tui options…]
#   ghostty/crypte --muse-auth
#
# Compatible = interactive TTY, TERM != dumb, truecolor, at least 80x24.
# --window forces the Ghostty window; print-only modes (--help, --smoke,
# --once, --sheet, --preview) always run in place. Launcher flags come
# first; the rest goes to kiro-horror-tui untouched. If your terminal
# renders truecolor without advertising it, export COLORTERM=truecolor.
# CRYPTE_BIN overrides the release binary path (tests).
#
# Builds the release version on first launch. rebuild (first arg only)
# syncs the latest origin/main into a dedicated worktree next to the
# checkout (<name>-latest), forces a release build there, then launches
# it with the remaining args. The current checkout is never touched.
# Plain launch opens the managed build when there is one, else the
# checkout's own. CRYPTE_LATEST_ROOT overrides the worktree path (tests).
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(dirname "$here")"
bin="${CRYPTE_BIN:-$root/target/release/kiro-horror-tui}"
latest_root="${CRYPTE_LATEST_ROOT:-$(dirname "$root")/$(basename "$root")-latest}"
latest_bin="$latest_root/target/release/kiro-horror-tui"

# Sync the latest origin/main into the dedicated worktree (detached, so
# it never conflicts with any checked-out branch), then force a release
# build there. The current checkout is never touched — a dirty tree does
# not block the rebuild. Fails without touching anything when the fetch
# fails or the managed worktree is dirty or unusable.
rebuild_latest() {
    git -C "$root" rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
        echo "crypte: rebuild: $root is not a git checkout" >&2
        return 1
    }
    git -C "$root" fetch -q origin >&2 || {
        echo "crypte: rebuild: git fetch origin failed" >&2
        return 1
    }
    git -C "$root" worktree prune >/dev/null 2>&1 || true
    if git -C "$root" worktree list --porcelain 2>/dev/null | grep -qxF "worktree $latest_root"; then
        if [ -n "$(git -C "$latest_root" status --porcelain)" ]; then
            echo "crypte: rebuild refused: $latest_root is dirty (it is launcher-managed, leave it alone)" >&2
            return 1
        fi
        git -C "$latest_root" checkout -q --detach origin/main >&2 || {
            echo "crypte: rebuild: cannot update $latest_root" >&2
            return 1
        }
    else
        if [ -e "$latest_root" ] && [ -n "$(ls -A "$latest_root")" ]; then
            echo "crypte: rebuild: $latest_root exists and is not a crypte worktree (move it away first)" >&2
            return 1
        fi
        git -C "$root" worktree add -q --detach "$latest_root" origin/main >&2 || {
            echo "crypte: rebuild: cannot create $latest_root" >&2
            return 1
        }
    fi
    printf 'crypte: rebuilt %s in %s\n' \
        "$(git -C "$latest_root" rev-parse --short HEAD)" "$latest_root" >&2
    cargo build --release --manifest-path "$latest_root/Cargo.toml"
}

if [ "${1:-}" = "rebuild" ]; then
    shift
    rebuild_latest || exit 1
fi
# Open the latest rebuilt version when there is one, else the
# checkout's own build (compiled below when missing).
if [ -z "${CRYPTE_BIN:-}" ] && [ -x "$latest_bin" ]; then
    bin="$latest_bin"
fi
if [ ! -x "$bin" ]; then
    cargo build --release --manifest-path "$root/Cargo.toml"
fi

window=0
shader=(--custom-shader="$here/crypte.glsl")
while [ $# -gt 0 ]; do
    case "${1:-}" in
        --window | --fenetre) window=1; shift ;;
        --no-shader | --sans-shader) shader=(); shift ;;
        *) break ;;
    esac
done

# Terminal advertising truecolor (or known to render it).
has_truecolor() {
    case "${COLORTERM:-}" in
        *truecolor* | *24bit*) return 0 ;;
    esac
    case "${TERM_PROGRAM:-}" in
        ghostty | kitty | WezTerm | vscode | iTerm.app | Hyper | rio) return 0 ;;
    esac
    case "${TERM:-}" in
        *-truecolor | *-direct | xterm-ghostty | xterm-kitty | foot* | rio* | alacritty* | wezterm*) return 0 ;;
    esac
    return 1
}

# At least 80x24 (documented requirement).
big_enough() {
    local size rows cols
    size=$(stty size 2>/dev/null) || return 1
    rows=${size% *}
    cols=${size#* }
    [ "${rows:-0}" -ge 24 ] && [ "${cols:-0}" -ge 80 ]
}

# stdin+stdout on a terminal? Computed once, outside any command
# substitution: stdout is a pipe there, so -t must not run inside one.
tty_ok=0
if [ -t 0 ] && [ -t 1 ]; then
    tty_ok=1
fi

# Empty = compatible, else the reason (for the fallback note).
incompatible_reason() {
    if [ "$tty_ok" -ne 1 ]; then
        echo "no interactive terminal"
    elif [ "${TERM:-dumb}" = "dumb" ]; then
        echo "TERM=dumb"
    elif ! has_truecolor; then
        echo "no truecolor"
    elif ! big_enough; then
        echo "smaller than 80x24"
    fi
}

# Modes that only print (no TUI): never open a window.
prints_only() {
    for arg in "$@"; do
        case "$arg" in
            -h | --help | --smoke | --once | --sheet | --planche | --preview | --apercu) return 0 ;;
        esac
    done
    return 1
}

if prints_only "$@"; then
    exec "$bin" "$@"
fi
if [ "$window" -eq 0 ]; then
    reason=$(incompatible_reason)
    if [ -z "$reason" ]; then
        exec "$bin" "$@"
    fi
    printf 'crypte: %s, opening a Ghostty window\n' "$reason" >&2
fi
exec ghostty --config-file="$here/crypte.conf" "${shader[@]}" -e "$bin" "$@"
